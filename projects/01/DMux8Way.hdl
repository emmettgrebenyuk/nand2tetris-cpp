// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in, sel=sel[0], a=oXX0, b=oXX1);

    DMux(in=oXX0, sel=sel[1], a=oX00, b=oX10);
    DMux(in=oX00, sel=sel[2], a=a, b=e);
    DMux(in=oX10, sel=sel[2], a=c, b=g);

    DMux(in=oXX1, sel=sel[1], a=oX01, b=oX11);
    DMux(in=oX01, sel=sel[2], a=b, b=f);
    DMux(in=oX11, sel=sel[2], a=d, b=h);
}